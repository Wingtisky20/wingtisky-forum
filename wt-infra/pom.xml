<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.wingtisky</groupId>
    <artifactId>wingtisky-forum</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>wt-infra</artifactId>
  <name>wt-infra</name>
  <description>中间件基础设施：连接、序列化、Key 规范、重试（机制，不含业务策略）</description>

  <dependencies>
    <dependency>
      <groupId>com.wingtisky</groupId>
      <artifactId>wt-domain</artifactId>
    </dependency>
    <dependency>
      <groupId>com.wingtisky</groupId>
      <artifactId>wt-common</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>

    <!-- 持久层的"机制"部分放在这里：连接池、SqlSessionFactory、事务管理器的配置。
         而 Mapper 接口与 SQL 是"策略"，留在各业务模块。

         为什么放在 wt-infra 而不是某个业务模块：wt-infra 的职责定义就是
         "连接、序列化、Key 规范、重试"——数据库连接正是"连接"。放这里只需声明一次；
         放业务模块则 M2 的 forum-content、M7 的 trade-*、M8 的 seckill-coupon
         都要各写一遍，且"连接配置该归谁"会变成一个每次都要重新回答的问题。

         代价：所有依赖 wt-infra 的模块都会拿到 jdbc 与 mybatis。这是可接受的——
         它们本来就在同一个进程里，且模块边界由 ArchUnit 保证，不靠依赖隔离。 -->
    <dependency>
      <groupId>org.mybatis.spring.boot</groupId>
      <artifactId>mybatis-spring-boot-starter</artifactId>
    </dependency>

    <!-- MySQL 驱动。版本由 spring-boot-starter-parent 管理（Boot 3.5.16 → 9.7.0），
         因此这里不写版本。

         ⚠️ 本机服务端是 MySQL 8.0.41，而驱动是 9.7.0——**这个组合必须实测**
         （与"Redisson 3.52 × Redis 5"同类问题）。若不兼容，在父 POM 显式固定到
         8.0.x 并记入 ADR-0001 的修订。
         实测结论：✅ 兼容（见 2026-09-29 的 troubleshooting 与 Task 2 的提交）。 -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
    </dependency>

    <!-- Redis 客户端（一）：Spring 官方 starter（底层 Lettuce）。
         本项目对 Redis 的**读写与脚本**用法都走这条路：令牌、限流计数、
         以及 M3 起的缓存读写 —— "执行 Lua + 存取字符串"正是 RedisTemplate 的主场。

         ⚠️ 2026-10-06 修订：本注释原文写着「Redisson 的强项是分布式锁与分布式对象，
         **留给 M8 的亮点 7**」「代价：M8 起会有两个 Redis 客户端共存」。
         那个说法与 spec §5.1 冲突 —— **亮点 1（M3 的多级缓存）的防击穿设计本来就是
         Redisson 锁**，不必等到 M8。详见 docs/03-design/m3-cache.md §5。

         「变更留痕」的落地方式是：**不删上面的原话**，只追加这段修订。
         原文的结论"两个客户端共存、要分清用途"仍然成立，只是共存的时间
         从 M8 提前到了 M3：
           · Lettuce（本依赖）—— 读写与 Lua 脚本
           · Redisson（下一个依赖）—— 只用于分布式锁
         曾经担心"两个客户端容易混"；实际的分界很干脆：**要锁语义才用 Redisson**。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>

    <!-- Redis 客户端（二）：Redisson。**只用于分布式锁**（M3 防击穿、M8 亮点 7）。
         版本由父 POM 的 dependencyManagement 管（3.52.0），这里不写。

         ⚠️ 高危区（CLAUDE.md 防幻觉闸门 5）：这个 starter 会装配自己的连接工厂，
         **有可能顶掉上面那个 Lettuce 的**。后果是隐蔽的 —— 不是启动报错，
         而是令牌刷新 / 限流在某次请求上出错。所以接入后的第一关**不是**新功能，
         而是**已有功能回归**：登录 / 刷新令牌 / 连续登录触发限流，三条都要照跑。
         回归挂了 → 改用 org.redisson:redisson 核心包 + 手写 @Bean 只暴露 RedissonClient。

         ⚠️ 本机 Redis 是 5.0.14.1（Windows 原生构建的天花板），而 Redisson 3.52.0
         可能用到 Redis 6+ 的命令。装上就要实测（已记在 STATUS 待核实表），
         报 ERR unknown command 则降级并修订 ADR-0001。 -->
    <dependency>
      <groupId>org.redisson</groupId>
      <artifactId>redisson-spring-boot-starter</artifactId>
    </dependency>
  </dependencies>
</project>
