# ============================================================
# 环境变量模板
#
# 用法：复制成 .env 并填入真实值。**.env 已在 .gitignore 里，绝不会入库。**
#   cp .env.example .env
#
# 在 IDEA 里运行：Run Configuration → Environment variables → 填这些键
# 在命令行运行：   set -a && source .env && set +a
# ============================================================

# ---- MySQL ----
# 用户名与库名不是敏感信息，但为了换环境方便也放在这里
DB_USERNAME=wingtisky
DB_PASSWORD=
# ⚠️ 必须加引号：URL 里的 & 不加引号时，`set -a && source .env` 会把 &
# 当成 shell 的后台运算符，变量只会被赋值到第一个 & 之前的部分（实测结果是空值）。
# ⚠️ characterEncoding 要写 UTF-8（Java 的字符集名），不能写 utf8mb4（MySQL 的叫法）。
DB_URL="jdbc:mysql://127.0.0.1:3306/wingtisky_forum?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai&characterEncoding=UTF-8"

# ---- Redis ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ---- JWT ----
# ⚠️ HS256 要求密钥**至少 256 位（32 字节）**，jjwt 会直接拒绝更短的密钥。
# 生成一个：openssl rand -base64 48
# **不要复用这个示例值**——它已经写在公开仓库里了。
JWT_SECRET=
