<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wingtisky.forum.forum.content.mapper.PostMapper">

    <!-- 列表用的列。**注意这里没有 content**：
         正文是 MEDIUMTEXT，列表页永远不读它——这是 M6 那个"大字段拖慢分页"
         的性能优化能够成立的前提。想加 content 进来之前，先回去看设计稿 §2.6。
         另外也刻意不写 SELECT *：它会把 content 一起捞出来，让这条约束失效。 -->
    <sql id="List_Columns">
        id, author_id, title, summary, status, top_flag, featured_flag,
        view_count, like_count, comment_count, collect_count, create_time
    </sql>

    <!-- 列表的筛选条件。**取数据和数总数共用这一段**——
         两边各写一遍的话，改了一处忘了另一处，表现是"总数说有 100 条、
         翻到第 3 页就空了"，而这类不一致极难联想到是 SQL 写岔了。

         按标签筛用 EXISTS 而不是 JOIN：
           · 现在只筛一个标签，JOIN 也不会重复（一篇帖子最多匹配一行）
           · 但**只要将来支持"同时筛多个标签"，JOIN 就会让同一篇帖子出现多行**——
             列表里同一篇帖子出现两次、总数也跟着偏大，而这两个现象
             都很难让人联想到是 JOIN 的问题
           EXISTS 是半连接语义："存在一条关联指向这个标签"，从写法上就不会重复。 -->
    <sql id="List_Filter">
        deleted = 0 AND status = 0
        <if test="authorId != null">
            AND author_id = #{authorId}
        </if>
        <if test="tagId != null">
            AND EXISTS (SELECT 1
                        FROM t_post_tag pt
                        WHERE pt.post_id = t_post.id
                          AND pt.tag_id = #{tagId})
        </if>
    </sql>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_post (author_id, title, content, summary)
        VALUES (#{authorId}, #{title}, #{content}, #{summary})
    </insert>

    <select id="selectById" resultType="com.wingtisky.forum.forum.content.entity.Post">
        SELECT id, author_id, title, content, summary, status, top_flag, featured_flag,
               view_count, like_count, comment_count, collect_count, create_time, update_time
        FROM t_post
        WHERE id = #{id} AND deleted = 0
    </select>

    <!-- ============================================================
         列表查询。两个排序分支都**写死在 SQL 里**，不用 ${} 拼列名——
         拼接意味着外部传进来的字符串会成为 SQL 的一部分，那是注入入口。

         ORDER BY 末尾的 `id DESC` 不是多余的：create_time 只精确到秒，
         同一秒发的帖子排序会不稳定——翻页时同一行可能在两页都出现、
         或者一页都没出现。加一个唯一的列兜底，顺序才是确定的。
         （M6 的 keyset 分页会把这个"兜底列"变成主角，那时再看这段。）
         ============================================================ -->
    <select id="selectPage" resultType="com.wingtisky.forum.forum.content.entity.Post">
        SELECT <include refid="List_Columns"/>
        FROM t_post
        WHERE <include refid="List_Filter"/>
        <choose>
            <!-- 最热。⚠️ 这里有个**表达式**（几个计数相乘相加），MySQL 用不了索引，
                 必然走 filesort。这是**已知的现状，不是遗漏**——M6 会拿它做对照，
                 用真实数据与 EXPLAIN 来决定怎么优化（设计稿 §10 的 ⑩）。 -->
            <when test="sort == 'HOT'">
                ORDER BY top_flag DESC,
                         (comment_count * 3 + like_count * 2 + collect_count) DESC,
                         id DESC
            </when>
            <otherwise>
                ORDER BY top_flag DESC, create_time DESC, id DESC
            </otherwise>
        </choose>
        LIMIT #{size} OFFSET #{offset}
    </select>

    <select id="countList" resultType="long">
        SELECT COUNT(*)
        FROM t_post
        WHERE <include refid="List_Filter"/>
    </select>

    <!-- 部分更新：传 null 的字段不动。
         ⚠️ 注意 summary 挂在 content 这个分支里——**摘要由正文派生**，
         只有正文变了才重算。放在外面的话，只改标题也会把摘要冲掉。
         ⚠️ 两个字段都为 null 时，<set> 会生成空的 SET 子句、SQL 直接语法错误；
         调用方（PostService.update）已在入口拦掉这种情况——与 UserMapper.updateProfile 同一处理。 -->
    <update id="updateContent">
        UPDATE t_post
        <set>
            <if test="title != null">title = #{title},</if>
            <if test="content != null">content = #{content}, summary = #{summary},</if>
        </set>
        WHERE id = #{id} AND deleted = 0
    </update>

    <!-- 评论数增减。delta 可能是负数（删评论）。
         GREATEST(..., 0) 是下限保护：计数一旦变成负数，界面上是个没法解释的数字，
         而且排查时很难判断它从哪来。 -->
    <update id="addCommentCount">
        UPDATE t_post
        SET comment_count = GREATEST(comment_count + #{delta}, 0)
        WHERE id = #{postId} AND deleted = 0
    </update>

    <!-- 点赞数 / 收藏数。与评论数同一套路（单语句、GREATEST 下限保护）。
         列名写死在这里而不是当参数传：能当参数传就意味着要拼 SQL，
         而那正是注入的口子。 -->
    <update id="addLikeCount">
        UPDATE t_post
        SET like_count = GREATEST(like_count + #{delta}, 0)
        WHERE id = #{postId} AND deleted = 0
    </update>

    <update id="addCollectCount">
        UPDATE t_post
        SET collect_count = GREATEST(collect_count + #{delta}, 0)
        WHERE id = #{postId} AND deleted = 0
    </update>

    <update id="softDelete">
        UPDATE t_post
        SET deleted = 1
        WHERE id = #{id} AND deleted = 0
    </update>

    <!-- view_count = view_count + 1 是**单条语句**，并发安全；
         换成"先查再写"就会丢更新。 -->
    <update id="incrementViewCount">
        UPDATE t_post
        SET view_count = view_count + 1
        WHERE id = #{id} AND deleted = 0
    </update>

</mapper>
