<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wingtisky.forum.forum.user.mapper.RoleMapper">

    <select id="selectByCode" resultType="com.wingtisky.forum.forum.user.entity.Role">
        SELECT id, code, name, description, create_time
        FROM t_role
        WHERE code = #{code}
    </select>

</mapper>
